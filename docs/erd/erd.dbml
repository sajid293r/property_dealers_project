  total_amount numeric(18,2) [not null, note: 'rolls up from the lines']
  currency text [not null]
  created_by uuid [not null]
  approved_by uuid
  approved_at timestamptz
  locked_at timestamptz
  Note: 'A planned limit on spend — per project, per fiscal year, or per capital item'
}

