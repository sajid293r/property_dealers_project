  other_deductions numeric(18,2) [not null]
  net_payable numeric(18,2) [not null]
  status text [not null, note: 'draft|approved|paid']
  bill_id uuid
  Note: 'Interim payment certificates (running bills)'
}

Table ipc_lines {
  id uuid [pk]
  company_id uuid [not null]
  ipc_id uuid [not null]
  item_id uuid [not null]
  quantity_this_period numeric(18,2) [not null]
  cumulative_quantity numeric(18,2) [not null]
  amount numeric(18,2) [not null]
  Note: 'Measured quantity per BOQ line'
}

Table retention_ledger {
  id uuid [pk]
  company_id uuid [not null]
  contract_id uuid [not null]
  ipc_id uuid
  amount numeric(18,2) [not null, note: '+ held, - released']
  event_date date [not null]
  note text [not null]
  Note: 'Retention held and released'
}

Table variation_orders {
  id uuid [pk]
  company_id uuid [not null]
  contract_id uuid [not null]
  description text [not null]
  amount numeric(18,2) [not null]
  status text [not null]
  approved_by uuid
  Note: 'Approved changes to scope/value'
}

Table milestones {
  id uuid [pk]
  company_id uuid [not null]
  contract_id uuid [not null]
  name text [not null]
  planned_date date [not null]
  actual_date date
  weight_pct numeric(18,2) [not null]
  Note: 'Planned milestones'
}

Table progress_reports {
  id uuid [pk]
  company_id uuid [not null]
  contract_id uuid [not null]
  report_date date [not null]
  progress_pct numeric(18,2) [not null]
  notes text [not null]
  reported_by uuid [not null]
  Note: 'Site progress reports'
}

Table progress_photos {
  id uuid [pk]
  company_id uuid [not null]
  report_id uuid [not null]
  file_id uuid [not null]
  caption text [not null]
  taken_at timestamptz [not null]
  geom geometry
  Note: 'Photos with date and location'
}

Table contractor_ratings {
  id uuid [pk]
  company_id uuid [not null]
  contractor_id uuid [not null]
  contract_id uuid
  rating int [not null]
  comment text [not null]
  rated_by uuid [not null]
  Note: 'Performance history'
}

Table guarantees {
  id uuid [pk]
  company_id uuid [not null]
  contract_id uuid [not null]
  kind text [not null]
  reference_no text [not null]
  amount numeric(18,2) [not null]
  expires_on date [not null]
  file_id uuid
  Note: 'Bank guarantees / insurance with expiry'
}

Table material_issues {
  id uuid [pk]
  company_id uuid [not null]
  contract_id uuid [not null]
  stock_movement_id uuid [not null]
  value numeric(18,2) [not null]
  Note: 'Stock issued to a contract'
}

Table departments {
  id uuid [pk]
  company_id uuid [not null]
  name text [unique, not null]
  head_employee_id uuid
  Note: 'Sales, Accounts, Operations…'
}

Table designations {
  id uuid [pk]
  company_id uuid [not null]
  name text [unique, not null]
  level int [not null]
  Note: 'Job titles'
}

Table employees {
  id uuid [pk]
  company_id uuid [not null]
  party_id uuid [unique, not null]
  user_id uuid [unique, note: 'login, if any']
  employee_no text [unique, not null]
  department_id uuid [not null]
  designation_id uuid [not null]
  manager_id uuid
  employment_type text [not null]
  joined_on date [not null]
  probation_end date
  confirmed_on date
  exit_date date
  bank_iban text [not null]
  status text [not null]
  Note: 'Employee file (also a party)'
}

Table salary_components {
  id uuid [pk]
  company_id uuid [not null]
  code text [unique, not null]
  name text [not null]
  kind text [not null, note: 'earning|deduction']
  taxable boolean [not null]
  formula jsonb [not null]
  Note: 'Basic, house rent, conveyance, medical…'
}

Table employee_salary_components {
  id uuid [pk]
  company_id uuid [not null]
  employee_id uuid [not null]
  component_id uuid [not null]
  amount numeric(18,2) [not null]
  effective_from date [not null]
  effective_to date
  Note: 'Effective-dated salary structure'
}

Table salary_history {
  id uuid [pk]
  company_id uuid [not null]
  employee_id uuid [not null]
  previous_total numeric(18,2) [not null]
  new_total numeric(18,2) [not null]
  effective_date date [not null]
  reason text [not null]
  approved_by uuid [not null]
  Note: 'Increments & changes'
}

Table shifts {
  id uuid [pk]
  company_id uuid [not null]
  name text [not null]
  start_time text [not null]
  end_time text [not null]
  grace_minutes int [not null]
  Note: 'Working shifts'
}

Table attendance_logs {
  id uuid [pk]
  company_id uuid [not null]
  employee_id uuid [not null]
  logged_at timestamptz [not null]
  direction text [not null]
  source text [not null, note: 'web|mobile|biometric']
  geom geometry
  Note: 'Raw check-in / check-out events'
}

Table attendance_daily {
  id uuid [pk]
  company_id uuid [not null]
  employee_id uuid [not null]
  work_date date [not null]
  shift_id uuid
  status text [not null, note: 'present|absent|leave|holiday']
  late_minutes int [not null]
  overtime_minutes int [not null]
  Note: 'Daily summary used by payroll'
}

Table holidays {
  id uuid [pk]
  company_id uuid [not null]
  holiday_date date [not null]
  name text [not null]
  Note: 'Public holiday calendar'
}

Table leave_types {
  id uuid [pk]
  company_id uuid [not null]
  name text [unique, not null]
  paid boolean [not null]
  carry_forward boolean [not null]
  Note: 'Casual, Sick, Annual, Unpaid'
}

Table leave_policies {
  id uuid [pk]
  company_id uuid [not null]
  leave_type_id uuid [not null]
  annual_days numeric(18,2) [not null]
  accrual text [not null]
  max_carry numeric(18,2) [not null]
  Note: 'Entitlement rules'
}

Table leave_balances {
  id uuid [pk]
  company_id uuid [not null]
  employee_id uuid [not null]
  leave_type_id uuid [not null]
  year int [not null]
  entitled numeric(18,2) [not null]
  used numeric(18,2) [not null]
  carried numeric(18,2) [not null]
  Note: 'Balance per employee per year'
}

Table leave_requests {
  id uuid [pk]
  company_id uuid [not null]
  employee_id uuid [not null]
  leave_type_id uuid [not null]
  from_date date [not null]
  to_date date [not null]
  days numeric(18,2) [not null]
  reason text [not null]
  status text [not null, note: 'pending|approved|rejected']
  approved_by uuid
  Note: 'Applications'
}

Table payroll_runs {
  id uuid [pk]
  company_id uuid [not null]
  period_id uuid [not null]
  month text [not null]
  status text [not null, note: 'draft|reviewed|approved|disbursed|locked']
  total_gross numeric(18,2) [not null]
  total_net numeric(18,2) [not null]
  journal_entry_id uuid
  approved_by uuid
  Note: 'Monthly payroll batch'
}

Table payslips {
  id uuid [pk]
  company_id uuid [not null]
  run_id uuid [not null]
  employee_id uuid [not null]
  gross numeric(18,2) [not null]
  deductions numeric(18,2) [not null]
  net numeric(18,2) [not null]
  pdf_file_id uuid
  Note: 'One per employee per run'
}

Table payslip_lines {
  id uuid [pk]
  company_id uuid [not null]
  payslip_id uuid [not null]
  component_id uuid
  label text [not null]
  kind text [not null]
  amount numeric(18,2) [not null]
  Note: 'Earnings / deductions'
}

Table staff_loans {
  id uuid [pk]
  company_id uuid [not null]
  employee_id uuid [not null]
  principal numeric(18,2) [not null]
  installments int [not null]
  issued_on date [not null]
  status text [not null]
  approved_by uuid [not null]
  voucher_id uuid
  Note: 'Advances & loans to staff'
}

Table loan_installments {
  id uuid [pk]
  company_id uuid [not null]
  loan_id uuid [not null]
  due_month text [not null]
  amount numeric(18,2) [not null]
  recovered_in_payslip_id uuid
  Note: 'Recovered through payroll'
}

Table sales_targets {
  id uuid [pk]
  company_id uuid [not null]
  employee_id uuid [not null]
  month text [not null]
  target_amount numeric(18,2) [not null]
  achieved_amount numeric(18,2) [not null]
  Note: 'Monthly targets per agent'
}

Table incentive_rules {
  id uuid [pk]
  company_id uuid [not null]
  name text [not null]
  basis text [not null]
  rate numeric(18,2) [not null]
  slabs jsonb [not null]
  active boolean [not null]
  Note: 'Commission / bonus rules for agents'
}

Table company_kpi_snapshots {
  id uuid [pk]
  company_id uuid [not null]
  snapshot_date date [not null]
  properties int [not null]
  available int [not null]
  collections numeric(18,2) [not null]
  cash numeric(18,2) [not null]
  receivable numeric(18,2) [not null]
  overdue numeric(18,2) [not null]
  Note: 'Daily summary for Group Overview & dashboards'
}

Table saved_reports {
  id uuid [pk]
  company_id uuid [not null]
  name text [not null]
  module text [not null]
  definition jsonb [not null]
  owner_id uuid [not null]
  shared boolean [not null]
  Note: 'Custom report definitions'
}

Table report_schedules {
  id uuid [pk]
  company_id uuid [not null]
  report_id uuid [not null]
  cron text [not null]
  recipients jsonb [not null]
  format text [not null]
  last_run_at timestamptz
  Note: 'Emailed reports'
}

Table plans {
  id uuid [pk]
  code text [unique, not null]
  name text [not null]
  price_monthly numeric(18,2) [not null]
  Note: 'Basic / Moderate / Premium'
}

Table plan_limits {
  id uuid [pk]
  plan_id uuid [not null]
  limit_key text [not null]
  limit_value int [not null]
  Note: 'Seats, companies, projects, storage per plan'
}

Table subscriptions {
  id uuid [pk]
  org_id uuid [not null]
  plan_id uuid [not null]
  status text [not null, note: 'trial|active|past_due|cancelled']
  current_period_end date [not null]
  cancel_at timestamptz
  Note: 'An organizations plan'
}

Table subscription_items {
  id uuid [pk]
  subscription_id uuid [not null]
  item_key text [not null]
  quantity int [not null]
  Note: 'Add-ons (extra seats / companies)'
}

Table usage_meters {
  id uuid [pk]
  org_id uuid [not null]
  meter text [not null]
  value numeric(18,2) [not null]
  recorded_on date [not null]
  Note: 'Measured usage'
}

Table saas_invoices {
  id uuid [pk]
  org_id uuid [not null]
  subscription_id uuid [not null]
  amount numeric(18,2) [not null]
  status text [not null]
  due_date date [not null]
  Note: 'Our invoices to the customer'
}

Table saas_payments {
  id uuid [pk]
  invoice_id uuid [not null]
  method text [not null, note: 'card|jazzcash|easypaisa|bank']
  amount numeric(18,2) [not null]
  reference text [not null]
  paid_at timestamptz [not null]
  Note: 'Payments received'
}

Table dunning_events {
  id uuid [pk]
  invoice_id uuid [not null]
  attempt int [not null]
  sent_at timestamptz [not null]
  Note: 'Failed-payment reminders'
}

Table coupons {
  id uuid [pk]
  code text [unique, not null]
  percent_off numeric(18,2) [not null]
  valid_until date
  Note: 'Discount codes'
}

