// PropIQ — generated by docs/erd/build.mjs. Import at https://dbdiagram.io (Import → DBML).

Table organizations {
  id uuid [pk]
  name text [not null]
  slug text [unique, not null]
  plan text [not null, note: 'basic|moderate|premium']
  status text [not null, note: 'trial|active|past_due|suspended|closed']
  Note: 'The paying customer / group owner'
}

Table companies {
  id uuid [pk]
  org_id uuid [not null]
  name text [not null]
  short_name text [not null]
  ntn text [not null]
  strn text [not null]
  city text [not null]
  province text [not null]
  address text [not null]
  phone text [not null]
  email text [not null]
  base_currency text [not null, note: 'PKR']
  fiscal_year_start int [not null, note: '7 = July']
  settings jsonb [not null]
  status text [not null]
  Note: 'A legal entity inside an organization'
}

Table users {
  id uuid [pk]
  email text [unique, not null]
  phone text [not null]
  full_name text [not null]
  password_hash text
  mfa_enabled boolean [not null]
  status text [not null, note: 'invited|active|suspended']
  last_login_at timestamptz [not null]
  Note: 'A login (person who signs in)'
}

Table org_members {
  org_id uuid
  user_id uuid
  org_role text [not null, note: 'owner|admin|member']

  indexes {
    (org_id, user_id) [pk]
  }
  Note: 'User belongs to an organization'
}

Table roles {
  id uuid [pk]
  org_id uuid [note: 'null = platform default']
  name text [not null]
  description text [not null]
  is_system boolean [not null]
  Note: 'Named permission bundle (system or custom)'
}

Table role_permissions {
  role_id uuid
  module text [note: 'matches frontend PERMISSION_MODULES']
  can_view boolean [not null]
  can_create boolean [not null]
  can_edit boolean [not null]
  can_delete boolean [not null]
  can_approve boolean [not null]
  data_scope text [not null, note: 'own|team|project|company']

  indexes {
    (role_id, module) [pk]
  }
  Note: 'Module x action grid + data scope'
}

Table company_members {
  company_id uuid
  user_id uuid
  role_id uuid [not null]
  status text [not null]

  indexes {
    (company_id, user_id) [pk]
  }
  Note: 'Which role a user holds in which company'
}

Table invitations {
  id uuid [pk]
  company_id uuid [not null]
  email text [not null]
  role_id uuid [not null]
  token_hash text [not null]
  expires_at timestamptz [not null]
  accepted_at timestamptz
  invited_by uuid [not null]
  Note: 'Pending invites to join a company'
}

Table sessions {
  id uuid [pk]
  user_id uuid [not null]
  refresh_token_hash text [not null]
  device text [not null]
  ip text [not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  Note: 'Active logins / devices'
}

Table api_keys {
  id uuid [pk]
  company_id uuid [not null]
  name text [not null]
  key_hash text [not null]
  scopes jsonb [not null]
  last_used_at timestamptz
  expires_at timestamptz
  Note: 'Machine access for integrations'
}

Table settings {
  id uuid [pk]
  company_id uuid [not null]
  key text [not null, note: 'numbering, marla_to_sqft, rounding, revenue policy']
