# Live mode: sign in with a real account and use real data. Copy to .env.local and fill in.
# Leave these empty and the app runs in demo mode only (built-in sample data), exactly as before.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The "publishable" (anon) key: Supabase Dashboard > Project Settings > API Keys. It is public by design.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where the PropIQ API (api/) is running.
NEXT_PUBLIC_API_URL=http://localhost:4000
