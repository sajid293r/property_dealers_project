{
  "name": "propiq-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PropIQ backend: a thin, tenant-safe HTTP layer over the Postgres rules in docs/schema/core.sql",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "migrate:reset": "tsx --env-file=.env src/migrate.ts --reset",
    "setup": "tsx --env-file=.env src/setup.ts",
    "sandbox": "tsx sandbox/sandbox.ts",
    "build:function": "node scripts/build-function.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
