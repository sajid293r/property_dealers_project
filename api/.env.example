# ── PropIQ API: copy to api/.env and fill in. Never commit the real file.

PORT=4000
LOG_LEVEL=info

# The API's everyday login: role propiq_app, through the Supabase pooler in TRANSACTION mode (port 6543).
# It cannot bypass row-level security. Looks like:
# postgresql://propiq_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# The owner login, used ONLY by `npm run migrate` (the direct or session-pooler connection string, port 5432).
# Do not give this to the running API.
MIGRATION_DATABASE_URL=

# Supabase Auth. Check Project Settings > API / JWT keys in the dashboard for which applies to your project.
#   New projects sign tokens with a key pair  -> set the JWKS URL:
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
#   Older projects share one secret            -> set this instead and leave the JWKS URL empty:
# SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Browser origins allowed to call the API (the Next.js site), comma separated.
CORS_ORIGIN=http://localhost:3000
